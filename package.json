{
  "name": "behoop-social",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "test": "vitest run shared worker",
    "test:rules": "firebase emulators:exec --only firestore --project demo-behoop \"vitest run tests/rules\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-behoop \"tsx ops/seed-demo.ts && playwright test\"",
    "app-data": "tsx ops/build-app-data.ts",
    "seed:demo": "tsx ops/seed-demo.ts",
    "render:local": "tsx ops/render/run.ts --local",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-behoop"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "exifr": "^7.1.3",
    "firebase": "^13.0.0",
    "hls.js": "^1.7.3",
    "idb": "^8.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "aws4fetch": "^1.0.20",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "jose": "^6.2.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
