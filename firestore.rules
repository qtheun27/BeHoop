rules_version = '2';
// Fichier fusionné : Espace Club (partie 1) + BeHoop Social (partie 2). Source unique à publier dans la console Firebase.

// Règles de sécurité — Espace Club (basket-awbb)
//
// Principe général : le rôle et le club de chaque utilisateur sont stockés
// dans un document users/{uid} (pas dans les "custom claims" Firebase Auth,
// qui nécessiteraient un serveur/Cloud Functions payant pour être écrits).
// Ces règles lisent ce document pour autoriser ou refuser chaque action.
//
// Modèle "joueur" : un JOUEUR (players/{id}) n'est pas forcément un compte
// de connexion. Deux cas :
//  - joueur auto-géré : account_uid == son propre uid (il a son compte)
//  - joueur géré par un parent : account_uid == null, parent_uids contient
//    l'uid du/des parent(s) qui le gèrent (utile pour les enfants sans email)
//
// Création de compte : passe obligatoirement par une invitation
// (invitations/{email}) créée par un admin. Sans invitation valide
// correspondant à son email, un utilisateur ne peut pas créer son profil
// users/{uid} — donc pas d'accès à l'application.

service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }

    function monEmail() {
      return request.auth.token.email.lower();
    }

    function monProfil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function monRole() {
      return monProfil().role;
    }

    function monClub() {
      return monProfil().club_id;
    }

    function estSuperAdmin() {
      return connecte() && monRole() == 'super_admin';
    }

    function estAdminDuClub(clubId) {
      return connecte() && monRole() == 'club_admin' && monClub() == clubId;
    }

    function estCoachDeLequipe(teamId) {
      return connecte() && monRole() == 'coach'
        && monProfil().get('team_ids', []).hasAny([teamId]);
    }

    function estParent() {
      return connecte() && monRole() == 'parent';
    }

    // Tout membre rattache au club (coach, joueur, parent, admin) : sert aux
    // contenus partages a l'echelle du club, comme les schemas tactiques.
    function estDuClub(clubId) {
      return connecte() && monClub() == clubId;
    }

    // Club auquel appartient une equipe, ou '' si la fiche equipe n'existe
    // pas encore. Sans ce garde-fou, un get() sur un document absent fait
    // echouer l'evaluation entiere et bloque des actions legitimes.
    function clubDeLequipe(teamId) {
      return exists(/databases/$(database)/documents/teams/$(teamId))
        ? get(/databases/$(database)/documents/teams/$(teamId)).data.club_id
        : '';
    }

    // --- Invitations -----------------------------------------------------
    // Id du document = email en minuscules (recherche directe sans requête).
    match /invitations/{email} {
      allow create: if estSuperAdmin()
                    || estAdminDuClub(request.resource.data.get('club_id', ''));

      allow read: if connecte() && (
                    monEmail() == email
                    || estSuperAdmin()
                    || estAdminDuClub(resource.data.get('club_id', ''))
                  );

      // La personne invitée ne peut que marquer son invitation "used",
      // rien d'autre (pas de changement de rôle/club).
      allow update: if (
                      monEmail() == email
                      && resource.data.get('status', '') == 'pending'
                      && request.resource.data.get('status', '') == 'used'
                      && request.resource.data.get('role', '') == resource.data.get('role', '')
                      && request.resource.data.get('club_id', '') == resource.data.get('club_id', '')
                      && request.resource.data.get('team_id', '') == resource.data.get('team_id', '')
                    )
                    || estSuperAdmin()
                    || estAdminDuClub(resource.data.get('club_id', ''));

      allow delete: if estSuperAdmin() || estAdminDuClub(resource.data.get('club_id', ''));
    }

    // --- Profils utilisateurs (comptes de connexion) -----------------------
    match /users/{uid} {
      allow read: if connecte() && (
                    request.auth.uid == uid
                    || estSuperAdmin()
                    || estAdminDuClub(resource.data.get('club_id', ''))
                    || (monRole() == 'coach' && resource.data.get('team_id', '') in monProfil().team_ids)
                  );

      // Création du profil UNIQUEMENT si une invitation valide existe pour
      // cet email, et que les infos écrites correspondent exactement à
      // l'invitation (impossible de s'auto-attribuer un rôle).
      allow create: if request.auth.uid == uid
                    && exists(/databases/$(database)/documents/invitations/$(monEmail()))
                    && get(/databases/$(database)/documents/invitations/$(monEmail())).data.status == 'pending'
                    && (request.resource.data.get('role', '') == get(/databases/$(database)/documents/invitations/$(monEmail())).data.role
                        // Invitation « joueur » acceptée par le parent qui gère le compte d'un enfant sans e-mail
                        || (request.resource.data.get('role', '') == 'parent' && get(/databases/$(database)/documents/invitations/$(monEmail())).data.role == 'player'))
                    && request.resource.data.get('club_id', '') == get(/databases/$(database)/documents/invitations/$(monEmail())).data.club_id;

      allow update: if request.auth.uid == uid
                      && request.resource.data.get('role', '') == resource.data.get('role', '')
                      && request.resource.data.get('club_id', '') == resource.data.get('club_id', '')
                    || estSuperAdmin()
                    || estAdminDuClub(resource.data.get('club_id', ''));

      allow delete: if estSuperAdmin() || estAdminDuClub(resource.data.get('club_id', ''));
    }

    // --- Joueurs (l'entité "joueur", avec ou sans compte de connexion) ----
    match /players/{playerId} {
      allow read: if connecte() && (
                    estSuperAdmin()
                    || estAdminDuClub(resource.data.get('club_id', ''))
                    || estCoachDeLequipe(resource.data.get('team_id', ''))
                    || resource.data.get('account_uid', '') == request.auth.uid
                    || request.auth.uid in resource.data.get('parent_uids', [])
                  );

      allow create: if estSuperAdmin()
                    || estAdminDuClub(request.resource.data.get('club_id', ''))
                    || estCoachDeLequipe(request.resource.data.get('team_id', ''))
                    // Un joueur qui crée sa propre fiche à la première connexion
                    || (connecte() && request.resource.data.get('account_uid', '') == request.auth.uid)
                    // Un parent qui ajoute un enfant depuis son espace
                    || (
                         estParent()
                         && request.auth.uid in request.resource.data.get('parent_uids', [])
                         && request.resource.data.get('account_uid', '') == ''
                         && request.resource.data.get('club_id', '') == monClub()
                       );

      allow update: if estSuperAdmin()
                    || estAdminDuClub(resource.data.get('club_id', ''))
                    || estCoachDeLequipe(resource.data.get('team_id', ''))
                    || resource.data.get('account_uid', '') == request.auth.uid
                    || request.auth.uid in resource.data.get('parent_uids', [])
                    // Un parent qui se lie lui-même à un enfant déjà créé
                    // (sans compte, sans parent) depuis son propre espace.
                    || (
                         estParent()
                         && resource.data.get('club_id', '') == monClub()
                         && resource.data.get('account_uid', '') == ''
                         && resource.data.get('parent_uids', []).size() == 0
                         && request.auth.uid in request.resource.data.get('parent_uids', [])
                       );

      allow delete: if estSuperAdmin() || estAdminDuClub(resource.data.get('club_id', ''));
    }

    // --- Clubs (juste un marqueur "ce club a un espace actif") -----------
    match /clubs/{clubId} {
      allow read: if connecte();
      allow write: if estSuperAdmin() || estAdminDuClub(clubId);
    }

    // --- Équipes ------------------------------------------------------------
    match /teams/{teamId} {
      allow read: if connecte();
      allow create: if estSuperAdmin() || estAdminDuClub(request.resource.data.get('club_id', ''));
      allow update, delete: if estSuperAdmin() || estAdminDuClub(resource.data.get('club_id', ''));
    }

    // --- Entraînements ------------------------------------------------------
    match /trainings/{trainingId} {
      allow read: if connecte();

      allow create: if estSuperAdmin()
                    || estCoachDeLequipe(request.resource.data.get('team_id', ''))
                    || estAdminDuClub(clubDeLequipe(request.resource.data.get('team_id', '')));

      allow update, delete: if estSuperAdmin()
                    || estCoachDeLequipe(resource.data.get('team_id', ''))
                    || estAdminDuClub(clubDeLequipe(resource.data.get('team_id', '')))
                    // Repli : l'auteur de l'entree peut toujours la gerer.
                    || resource.data.get('created_by', '') == request.auth.uid;
    }

    // --- Statistiques joueurs (référencent players/{id} via player_id) ----
    match /player_stats/{statId} {
      allow read: if connecte() && (
                    estSuperAdmin()
                    || estCoachDeLequipe(resource.data.get('team_id', ''))
                    || estAdminDuClub(clubDeLequipe(resource.data.get('team_id', '')))
                    || get(/databases/$(database)/documents/players/$(resource.data.get('player_id', ''))).data.get('account_uid', '') == request.auth.uid
                    || request.auth.uid in get(/databases/$(database)/documents/players/$(resource.data.get('player_id', ''))).data.get('parent_uids', [])
                  );

      allow create: if estSuperAdmin()
                    || estCoachDeLequipe(request.resource.data.get('team_id', ''))
                    || estAdminDuClub(clubDeLequipe(request.resource.data.get('team_id', '')));

      allow update, delete: if estSuperAdmin()
                    || estCoachDeLequipe(resource.data.get('team_id', ''))
                    || estAdminDuClub(clubDeLequipe(resource.data.get('team_id', '')));
    }

    // --- Tableaux tactiques (phases de jeu / exercices, par équipe) ------
    match /plays/{playId} {
      // Lecture ouverte a l'equipe concernee : le joueur (ou son parent)
      // doit pouvoir consulter les phases de jeu et exercices du coach.
      // Lecture au niveau du CLUB (et non de l'equipe) : l'appli liste les
      // schemas par club_id, or Firestore evalue la regle sur la requete
      // entiere — une condition portant sur team_id ferait echouer toute
      // la requete ("insufficient permissions") meme pour un coach legitime.
      // IMPORTANT : tous les champs sont lus avec .get(..., defaut). Un
      // schema enregistre par une version anterieure peut ne pas avoir de
      // club_id ; lire un champ absent fait echouer TOUTE la regle et
      // refuse l'action, meme quand une autre condition suffisait.
      allow read: if estSuperAdmin()
                  || estDuClub(resource.data.get('club_id', ''))
                  || estCoachDeLequipe(resource.data.get('team_id', ''));

      allow create: if estSuperAdmin()
                    || ((monRole() == 'coach' || monRole() == 'club_admin')
                        && estDuClub(request.resource.data.get('club_id', '')));

      allow update, delete: if estSuperAdmin()
                    || ((monRole() == 'coach' || monRole() == 'club_admin')
                        && estDuClub(resource.data.get('club_id', '')))
                    || estCoachDeLequipe(resource.data.get('team_id', ''))
                    // Repli : l'auteur du schema peut toujours le gerer.
                    || resource.data.get('created_by', '') == request.auth.uid;
    }

    // --- Hoop Camp (programmes individuels, Espace Club) -------------------
    // hoopcamp/{joueur} : profil d'entraînement + programme en cours ;
    // hoopcamp/{joueur}/days/{AAAA-MM-JJ} : séance du jour, cases cochées, note, validations.
    // Accès limité au joueur, à ses parents liés et au coach de SON équipe (données de mineurs).
    // Le joueur coche et écrit ses notes ; seuls un parent lié ou le coach écrivent les validations (ratings).
    // Auto-évaluation (selfRatings) uniquement pour un joueur sans parent ni coach lié.
    function hcJoueur(pid) { return get(/databases/$(database)/documents/players/$(pid)).data; }
    function hcEstLeJoueur(pid) { return connecte() && hcJoueur(pid).get('account_uid', '') == request.auth.uid; }
    function hcEstParent(pid) { return connecte() && request.auth.uid in hcJoueur(pid).get('parent_uids', []); }
    function hcEstCoach(pid) { return estCoachDeLequipe(hcJoueur(pid).get('team_id', '')); }
    function hcProche(pid) { return hcEstLeJoueur(pid) || hcEstParent(pid) || hcEstCoach(pid); }
    // Qui coche : le joueur, ou le parent d'un enfant sans compte (l'enfant utilise le téléphone du parent)
    function hcFait(pid) { return hcEstLeJoueur(pid) || (hcEstParent(pid) && hcJoueur(pid).get('account_uid', '') == ''); }
    function hcValide(pid) { return hcEstParent(pid) || hcEstCoach(pid); }
    function hcSansCoach(teamId) {
      return teamId == null || teamId == ''
        || !exists(/databases/$(database)/documents/teams/$(teamId))
        || get(/databases/$(database)/documents/teams/$(teamId)).data.get('coach_uids', []).size() == 0;
    }
    function hcAutoEval(pid) { return hcJoueur(pid).get('parent_uids', []).size() == 0 && hcSansCoach(hcJoueur(pid).get('team_id', '')); }

    match /hoopcamp/{pid} {
      allow read: if hcProche(pid);
      // Profil et programme : le joueur ou ses parents ; le coach peut seulement lui envoyer un programme
      allow create: if request.resource.data.get('player_id', '') == pid
                    && ((hcFait(pid) || hcEstParent(pid)) || (hcEstCoach(pid) && request.resource.data.keys().hasOnly(['player_id', 'program', 'updated'])));
      allow update: if request.resource.data.get('player_id', '') == pid
                    && ((hcFait(pid) || hcEstParent(pid)) || (hcEstCoach(pid) && onlyChanged(['program', 'updated'])));
      allow delete: if false;

      match /days/{date} {
        allow read: if hcProche(pid);
        allow create: if hcFait(pid)
                      && request.resource.data.get('date', '') == date
                      && request.resource.data.keys().hasOnly(['date', 'program', 'items', 'checks', 'note', 'team_id', 'updated', 'selfRatings'])
                      && (!('selfRatings' in request.resource.data) || hcAutoEval(pid))
                      && request.resource.data.get('team_id', null) == hcJoueur(pid).get('team_id', null);
        allow update: if (hcFait(pid)
                          && request.resource.data.date == resource.data.date
                          && onlyChanged(['program', 'items', 'checks', 'note', 'updated', 'selfRatings'])
                          && (unchanged(['selfRatings']) || hcAutoEval(pid)))
                      || (hcValide(pid) && onlyChanged(['ratings', 'updated']));
        allow delete: if false;
      }
    }

    // Programme envoyé par un coach à son équipe (ou à certains joueurs). Lisible par le club (pas de donnée personnelle,
    // sauf le classement d'équipe — prénoms et points — si le coach l'a activé).
    match /hoopcamp_assign/{id} {
      allow read: if estSuperAdmin() || estDuClub(resource.data.get('club_id', ''));
      allow create: if estSuperAdmin()
                    || (estCoachDeLequipe(request.resource.data.get('team_id', '')) && request.resource.data.get('club_id', '') == monClub())
                    || estAdminDuClub(request.resource.data.get('club_id', ''));
      allow update, delete: if estSuperAdmin()
                    || estCoachDeLequipe(resource.data.get('team_id', ''))
                    || estAdminDuClub(resource.data.get('club_id', ''));
    }

    // =====================================================================
    // BeHoop Social (behoop.be/app) — collections distinctes de l'Espace Club
    // =====================================================================

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'q.theuninck@gmail.com' && request.auth.token.email_verified == true; }
    function profile() { return get(/databases/$(database)/documents/profiles/$(uid())); }
    function active() { return signedIn() && exists(/databases/$(database)/documents/profiles/$(uid())) && profile().data.get('banned', false) != true; }
    function memberDoc(teamId) { return /databases/$(database)/documents/teamMembers/$(string(teamId))/members/$(uid()); }
    function isMember(teamId) { return signedIn() && exists(memberDoc(teamId)) && get(memberDoc(teamId)).data.status == 'accepted'; }
    function isResponsible(teamId) { return isMember(teamId) && get(memberDoc(teamId)).data.role == 'responsable'; }
    // Catégorie inconnue (pas de document teamInfo) → Jeunes, par sécurité.
    function isSeniors(teamId) {
      let p = /databases/$(database)/documents/teamInfo/$(string(teamId));
      return exists(p) && get(p).data.get('ageGroupOverride', get(p).data.ageGroup) == 'seniors';
    }
    function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---------- Profils (« users » du cahier des charges) ----------
    match /profiles/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      allow create: if signedIn() && uid() == userId && request.resource.data.ageConfirmed == true
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 40
        && request.resource.data.get('banned', false) == false;
      allow update: if (signedIn() && uid() == userId && unchanged(['banned'])) || isAdmin();
      allow delete: if signedIn() && uid() == userId;
    }
    match /legalAcceptances/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // ---------- Suivis ----------
    match /follows/{userId}/items/{itemId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // ---------- Infos équipe (Jeunes/Seniors) ----------
    match /teamInfo/{teamId} {
      allow read: if true;
      // Personnalisation (nom/logo/couleurs) par un membre ; correction Jeunes/Seniors par le super admin.
      allow write: if isAdmin() || (active() && isMember(int(teamId)) && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['override']));
    }

    // ---------- Équipes 🔒 ----------
    match /teamMembers/{teamId}/members/{memberId} {
      allow read: if signedIn() && (uid() == memberId || isMember(int(teamId)) || isAdmin());
      // Demande d'accès : uniquement pour soi, en attente, rôle membre.
      allow create: if (active() && uid() == memberId && request.resource.data.status == 'pending' && request.resource.data.role == 'membre'
                        && request.resource.data.uid == memberId && request.resource.data.teamId == int(teamId)
                        && request.resource.data.get('message', '').size() <= 200)
                    || isAdmin();
      // Accepter / nommer responsable : responsable de l'équipe ou super admin.
      allow update: if (isResponsible(int(teamId)) && onlyChanged(['status', 'role'])) || isAdmin();
      // Quitter (soi-même), retirer/refuser (responsable), super admin.
      allow delete: if signedIn() && (uid() == memberId || isResponsible(int(teamId)) || isAdmin());
    }
    // Requête « mes adhésions » (collectionGroup members where uid == moi)
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && (resource.data.uid == uid() || isAdmin());
    }

    // ---------- Posts ----------
    function canRead(d) {
      return d.visibility == 'public' || isAdmin() || (d.teamIdPrivate != null && isMember(d.teamIdPrivate));
    }
    function validNewPost(d, postId) {
      let hasMedia = d.type == 'photo';
      let team = d.teamIds.size() == 1 ? d.teamIds[0] : null;
      return active() && d.authorUid == uid() && d.hidden == false && d.reactions.size() == 0
        && d.type in ['photo', 'message']
        && d.get('payload', {}).get('text', '').size() <= 500
        && d.get('payload', {}).get('photos', []).size() <= 10
        // Média d'une équipe Jeunes : visibilité équipe obligatoire et auteur membre accepté.
        && (!hasMedia || (team != null && (
              (isSeniors(team) && d.visibility == 'public' && d.teamIdPrivate == null)
           || (!isSeniors(team) && d.visibility == 'team' && d.teamIdPrivate == team && isMember(team)))))
        && (hasMedia || (d.visibility == 'public' && d.teamIdPrivate == null));
    }
    function validLivePost(d, postId) {
      return active() && postId.matches('live-[0-9]+') && d.type == 'live' && d.visibility == 'public' && d.teamIdPrivate == null && d.authorUid == uid();
    }
    // Réaction : seul le compteur change, d'au plus ±1 par emoji, en cohérence avec le document reactions/{uid}.
    function validReactionUpdate(postId) {
      let before = resource.data.reactions;
      let after = request.resource.data.reactions;
      let mine = /databases/$(database)/documents/posts/$(postId)/reactions/$(uid());
      return onlyChanged(['reactions'])
        && after.keys().hasOnly(['🏀', '🔥', '👏'])
        && (existsAfter(mine) != exists(mine) || getAfter(mine).data.emoji != get(mine).data.emoji);
    }
    match /posts/{postId} {
      allow read: if canRead(resource.data);
      allow create: if validNewPost(request.resource.data, postId) || validLivePost(request.resource.data, postId);
      allow update: if
          // Score en direct : tout compte (dernier qui écrit gagne)
          (resource.data.type == 'live' && validLivePost(request.resource.data, postId) && onlyChanged(['payload', 'authorUid', 'authorName', 'createdAt', 'hidden', 'reactions', 'type', 'clubId', 'teamIds', 'targets', 'visibility', 'teamIdPrivate']))
          // Réactions
       || (active() && canRead(resource.data) && validReactionUpdate(postId))
          // « Je suis parent — retirer ce contenu » : masquage immédiat par tout lecteur d'un média Jeunes
       || (active() && resource.data.visibility == 'team' && canRead(resource.data) && onlyChanged(['hidden', 'hiddenReason', 'hiddenBy', 'hiddenAt'])
           && request.resource.data.hidden == true && request.resource.data.hiddenReason == 'parent' && request.resource.data.hiddenBy == uid())
          // Masquage par l'auteur ou un responsable de l'équipe
       || (active() && onlyChanged(['hidden', 'hiddenReason', 'hiddenBy', 'hiddenAt']) && request.resource.data.hidden == true
           && (resource.data.authorUid == uid() || (resource.data.teamIds.size() > 0 && isResponsible(resource.data.teamIds[0]))))
          // Réactivation, modération : super admin uniquement
       || isAdmin();
      allow delete: if (signedIn() && resource.data.authorUid == uid()) || isAdmin();

      match /reactions/{userId} {
        allow read: if signedIn() && uid() == userId;
        allow create, update: if active() && uid() == userId && request.resource.data.emoji in ['🏀', '🔥', '👏']
          && canRead(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow delete: if signedIn() && uid() == userId;
      }
    }

    // ---------- Fils de discussion : commentaires et réactions (actus, matchs, publications) ----------
    // threads/{clé} : « news-{id} », « game-{id} » (public) ou « post-{id} » (même visibilité que la publication).
    function threadPublic(key) { return key.matches('(news|game)-[A-Za-z0-9_]+'); }
    function threadPost(key) { return get(/databases/$(database)/documents/posts/$(key.replace('^post-', ''))).data; }
    function canReadThread(key) { return threadPublic(key) || (key.matches('post-[A-Za-z0-9_-]+') && canRead(threadPost(key))); }
    function counts(m) { return m.keys().hasOnly(['🏀', '🔥', '👏']); }
    function step(a, b) { return a - b >= -1 && a - b <= 1; }
    // Chaque compteur de réaction bouge d'au plus 1 (et reste positif)
    function reactStep(after, before) {
      return step(after.get('🏀', 0), before.get('🏀', 0)) && step(after.get('🔥', 0), before.get('🔥', 0)) && step(after.get('👏', 0), before.get('👏', 0))
        && after.get('🏀', 0) >= 0 && after.get('🔥', 0) >= 0 && after.get('👏', 0) >= 0;
    }
    match /threads/{key} {
      allow read: if canReadThread(key);
      allow create: if active() && canReadThread(key) && request.resource.data.keys().hasOnly(['reactions', 'comments'])
        && counts(request.resource.data.get('reactions', {})) && reactStep(request.resource.data.get('reactions', {}), {})
        && request.resource.data.comments is int && request.resource.data.comments >= 0 && request.resource.data.comments <= 1;
      // Compteurs : réaction (cohérente avec reactions/{moi}) ou commentaire (±1 à la fois)
      allow update: if active() && canReadThread(key) && onlyChanged(['reactions', 'comments'])
        && counts(request.resource.data.get('reactions', {})) && reactStep(request.resource.data.get('reactions', {}), resource.data.get('reactions', {}))
        && request.resource.data.comments is int && request.resource.data.comments >= 0 && step(request.resource.data.comments, resource.data.get('comments', 0))
        && (request.resource.data.get('reactions', {}) == resource.data.get('reactions', {})
            || existsAfter(/databases/$(database)/documents/threads/$(key)/reactions/$(uid())) != exists(/databases/$(database)/documents/threads/$(key)/reactions/$(uid()))
            || getAfter(/databases/$(database)/documents/threads/$(key)/reactions/$(uid())).data.emoji != get(/databases/$(database)/documents/threads/$(key)/reactions/$(uid())).data.emoji)
        || isAdmin();
      match /reactions/{userId} {
        allow read: if signedIn() && uid() == userId;
        allow create, update: if active() && uid() == userId && request.resource.data.keys().hasOnly(['emoji']) && request.resource.data.emoji in ['🏀', '🔥', '👏'] && canReadThread(key);
        allow delete: if signedIn() && uid() == userId;
      }
      match /comments/{commentId} {
        allow read: if canReadThread(key);
        allow create: if active() && canReadThread(key) && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'text', 'createdAt', 'hidden'])
          && request.resource.data.authorUid == uid() && request.resource.data.hidden == false
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 60
          && request.resource.data.createdAt == request.time;
        // L'auteur ou l'admin masque ; seul l'admin réactive
        allow update: if (signedIn() && resource.data.authorUid == uid() && onlyChanged(['hidden']) && request.resource.data.hidden == true) || isAdmin();
        allow delete: if (signedIn() && resource.data.authorUid == uid()) || isAdmin();
      }
    }

    // Liste personnelle de mes commentaires (pour les effacer avec le compte) : moi seul
    match /myComments/{userId}/items/{commentId} {
      allow read, delete: if signedIn() && uid() == userId;
      allow create: if active() && uid() == userId && request.resource.data.keys().hasOnly(['thread']) && request.resource.data.thread is string
        && existsAfter(/databases/$(database)/documents/threads/$(request.resource.data.thread)/comments/$(commentId));
    }

    // Liste personnelle de mes covoiturages (annonces et demandes), pour tout effacer avec le compte : moi seul
    match /myCarpools/{userId}/items/{offerId} {
      allow read, delete: if signedIn() && uid() == userId;
      allow create, update: if active() && uid() == userId && request.resource.data.keys().hasOnly(['game']) && request.resource.data.game is int;
    }

    // ---------- Signalements ----------
    match /reports/{reportId} {
      // postId : la publication, ou « c~{fil}~{commentaire} » pour un commentaire
      allow create: if active() && request.resource.data.reporterUid == uid() && request.resource.data.status == 'open'
        && reportId == request.resource.data.postId + '_' + uid();
      allow read, update, delete: if isAdmin();
    }

    // ---------- Montage vidéo ----------
    function canReadVideo(d) { return d.authorUid == uid() || d.visibility == 'public' || isAdmin() || (d.get('teamIdPrivate', null) != null && isMember(d.teamIdPrivate)); }
    match /matchVideos/{id} {
      allow read: if signedIn() && canReadVideo(resource.data);
      allow create: if active() && request.resource.data.authorUid == uid() && request.resource.data.status == 'draft'
        && (request.resource.data.visibility == 'team' || isSeniors(request.resource.data.teamIds[0]));
      // L'auteur modifie ses réglages et médias ; statut/HLS réservés au pipeline (compte de service).
      allow update: if (signedIn() && resource.data.authorUid == uid() && unchanged(['authorUid', 'hls', 'visibility', 'teamIdPrivate', 'version'])
                        && request.resource.data.status in ['draft', 'uploading', 'queued', 'deleted'])
                    || isAdmin();
      allow delete: if (signedIn() && resource.data.authorUid == uid()) || isAdmin();
    }
    match /renderJobs/{id} {
      allow read: if signedIn() && (resource.data.authorUid == uid() || isAdmin());
    }

    // ---------- V2 : score en direct ----------
    match /liveScores/{gameId} {
      allow read: if true;
      allow create, update: if active() && request.resource.data.updatedBy == uid()
        && request.resource.data.home is int && request.resource.data.away is int
        && request.resource.data.home >= 0 && request.resource.data.away >= 0 && request.resource.data.home < 250 && request.resource.data.away < 250
        && request.resource.data.quarter in [1, 2, 3, 4] && request.resource.data.history.size() <= 200
        && (resource == null || resource.data.get('status', 'live') != 'official');
    }

    // ---------- V2 : Moments et vote « Action du match » ----------
    match /moments/{id} {
      allow read: if signedIn() && canReadVideo(get(/databases/$(database)/documents/matchVideos/$(resource.data.matchVideoId)).data);
      match /votes/{userId} {
        allow read: if signedIn();
        allow create: if active() && uid() == userId;
      }
    }
    match /momentVotes/{matchVideoId}/votes/{userId} {
      allow read: if signedIn();
      // un vote par compte et par match, pendant 48 h après la publication des Moments
      allow create, update: if active() && uid() == userId && request.resource.data.momentId is string
        && request.time < get(/databases/$(database)/documents/matchVideos/$(matchVideoId)).data.voteUntil;
    }

    // ---------- V2 : covoiturage ----------
    function carpoolAllowed(teamIdPrivate) { return teamIdPrivate == null || isMember(teamIdPrivate); }
    match /carpools/{gameId}/offers/{offerId} {
      allow read: if active() && carpoolAllowed(resource.data.teamIdPrivate);
      allow create: if active() && request.resource.data.driverUid == uid() && carpoolAllowed(request.resource.data.teamIdPrivate)
        && request.resource.data.requests.size() == 0 && request.resource.data.seats >= 0 && request.resource.data.seats <= 8;
      allow update: if active() && carpoolAllowed(resource.data.teamIdPrivate) && onlyChanged(['requests', 'seats', 'from', 'time', 'meet']) && (
          (resource.data.driverUid == uid() && request.resource.data.seats >= 0 && request.resource.data.seats <= 8)
          // un passager ne touche qu'à sa propre demande : l'envoyer (en attente) ou l'annuler
       || (request.resource.data.requests.diff(resource.data.requests).affectedKeys().hasOnly([uid()]) && onlyChanged(['requests'])
           && (!(uid() in request.resource.data.requests) || request.resource.data.requests[uid()].status == 'pending')));
      allow delete: if signedIn() && resource.data.driverUid == uid();

      // Coordonnées : visibles par le propriétaire, le conducteur, et un passager accepté (après acceptation).
      match /contacts/{userId} {
        function offer() { return get(/databases/$(database)/documents/carpools/$(gameId)/offers/$(offerId)).data; }
        allow write: if active() && uid() == userId;
        allow read: if signedIn() && (uid() == userId
          || (offer().driverUid == uid() && offer().requests.get(userId, {}).get('status', '') == 'accepted')
          || (userId == offer().driverUid && offer().requests.get(uid(), {}).get('status', '') == 'accepted'));
      }
    }

    // Résultats rapides (ops/live-results.ts) : publics en lecture, écrits par le serveur seulement.
    match /results/{gameId} { allow read: if true; allow write: if false; }

    // Journal anti-spam des notifications : serveur uniquement.
    match /notifLog/{id} { allow read, write: if false; }
  }
}
