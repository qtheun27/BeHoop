{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": false, "noUnusedLocals": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "isolatedModules": true, "types": ["vite/client", "node"]
  },
  "include": ["web", "shared", "ops"],
  "exclude": ["node_modules", "app"]
}
