# Exemple de configuration — copier en .env.local (jamais commité). Aucune vraie valeur ici.
# --- Front (Vite) : valeurs publiques ---
VITE_WORKER_URL=https://media.behoop.be
VITE_FCM_VAPID_KEY=clé-publique-vapid-de-la-console-firebase
# VITE_USE_EMULATOR=1        # pour développer avec l'émulateur Firebase

# --- Scripts serveur / GitHub Actions (secrets) ---
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"basket-awbb-club","private_key":"...","client_email":"..."}
R2_ACCOUNT_ID=identifiant-compte-cloudflare
R2_ACCESS_KEY_ID=cle-acces-r2
R2_SECRET_ACCESS_KEY=secret-r2
R2_BUCKET=behoop-media

# --- Worker (npx wrangler secret put NOM) ---
# FIREBASE_SERVICE_ACCOUNT, GITHUB_TOKEN, RENDER_SECRET, MEDIA_COOKIE_SECRET,
# R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, ANTHROPIC_API_KEY (optionnel), SUPER_ADMIN_UID (optionnel)
